<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Our Family Secret Santa 🎄</title>
<style>
:root{
  --green:#173f35; --green2:#245b4c; --cream:#fffaf0; --red:#9f3030;
  --gold:#c89b3c; --ink:#26332e; --muted:#68756f; --card:#ffffff;
  --shadow:0 14px 40px rgba(23,63,53,.14);
}
*{box-sizing:border-box} body{margin:0;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:
radial-gradient(circle at 10% 10%,#fff 0 3px,transparent 4px),
linear-gradient(135deg,#f6efe0,#fffaf0 50%,#eef5ef);min-height:100vh}
header{background:var(--green);color:white;padding:18px 20px;position:sticky;top:0;z-index:10;box-shadow:0 4px 18px #0002}
.nav{max-width:1100px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:15px}
.logo{font-weight:800;font-size:1.05rem}.logo span{color:#e5bf62}
nav button{border:0;background:transparent;color:#fff;cursor:pointer;font-weight:700;padding:9px}
main{max-width:1100px;margin:auto;padding:28px 18px 70px}
.hero{background:linear-gradient(145deg,var(--green),#102f29);color:white;border-radius:28px;padding:48px 30px;box-shadow:var(--shadow);text-align:center;overflow:hidden;position:relative}
.hero:before{content:"✦  ✧  ✦  ✧  ✦";position:absolute;top:15px;left:0;right:0;color:#e5bf62;font-size:22px;letter-spacing:20px}
h1{font-family:Georgia,serif;font-size:clamp(2.1rem,6vw,4rem);margin:25px 0 8px}.hero p{max-width:650px;margin:0 auto 25px;color:#e8f0ec;font-size:1.08rem}
.btn{border:0;border-radius:999px;padding:12px 18px;font-weight:800;cursor:pointer;background:var(--red);color:white;box-shadow:0 5px 12px #0002}
.btn.alt{background:white;color:var(--green)}.btn.gold{background:var(--gold);color:#17251f}.btn.small{padding:8px 12px;font-size:.88rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-top:22px}
.card{background:var(--card);border-radius:20px;padding:22px;box-shadow:var(--shadow);border:1px solid #eadfca}
.card h2,.card h3{margin-top:0;font-family:Georgia,serif}.muted{color:var(--muted)}
.hidden{display:none!important}.center{text-align:center}
select,input,textarea{width:100%;padding:12px;border:1px solid #d7d0c2;border-radius:12px;font:inherit;background:#fff}
label{font-weight:700;font-size:.9rem;display:block;margin:12px 0 6px}
.notice{background:#f7efd9;border-left:5px solid var(--gold);padding:13px 15px;border-radius:10px;margin:15px 0}
.reveal{background:linear-gradient(145deg,#fffdf7,#f5ead3);border:2px dashed var(--gold);text-align:center;padding:30px;border-radius:22px}
.reveal .name{font:700 2.3rem Georgia,serif;color:var(--red);margin:12px 0}
.tag{display:inline-block;padding:5px 9px;border-radius:999px;background:#e9f2ee;color:var(--green);font-size:.8rem;font-weight:800;margin:3px}
.person{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #eee}.person:last-child{border:0}
.wish{padding:15px;border:1px solid #e6dfd1;border-radius:14px;margin:10px 0;background:#fffdf8}
.wish strong{display:block}.wish a{color:var(--red);font-weight:700}.price{font-weight:800;color:var(--green)}
footer{text-align:center;color:var(--muted);padding:25px}
@media(max-width:650px){.hero{padding:38px 20px}.nav nav button{padding:6px}.card{padding:18px}}
</style>
</head>
<body>
<header>
 <div class="nav">
  <div class="logo">🎄 Our Family <span>Secret Santa</span></div>
  <nav><button onclick="show('home')">Home</button><button onclick="show('login')">My Santa</button><button onclick="show('wishlist')">Wishlist</button><button onclick="show('admin')">Coordinator</button></nav>
 </div>
</header>
<main>
<section id="home">
 <div class="hero">
  <h1>Our Family Secret Santa</h1>
  <p>A little Christmas magic, a lot of fun, and one very important rule: <b>keep your Secret Santa secret!</b></p>
  <button class="btn alt" onclick="show('login')">🎁 Enter My Secret Santa</button>
 </div>
 <div class="grid">
  <div class="card"><h3>🎁 One Secret Santa</h3><p class="muted">Everyone gets one person to shop for, with household restrictions built in.</p></div>
  <div class="card"><h3>📝 Wish Lists</h3><p class="muted">Add ideas, links, prices, sizes, colors and notes so shopping is easier.</p></div>
  <div class="card"><h3>🔐 Family Coordinator</h3><p class="muted">The coordinator can help manage the kids' assignments and lists.</p></div>
 </div>
</section>

<section id="login" class="hidden">
 <div class="card" style="max-width:600px;margin:auto">
  <h2>🎅 Who are you?</h2>
  <p class="muted">Choose your name to open your private Secret Santa page.</p>
  <select id="personSelect"></select>
  <button class="btn" style="margin-top:14px;width:100%" onclick="login()">Open My Page</button>
  <div class="notice">🔒 This family version keeps your information in this browser. For a shared online version, connect the site to a database before publishing.</div>
 </div>
</section>

<section id="dashboard" class="hidden">
 <div id="dash"></div>
</section>

<section id="wishlist" class="hidden">
 <div class="card" style="max-width:760px;margin:auto">
  <h2>📝 My Wishlist</h2><p class="muted" id="wishFor">Choose your name first.</p>
  <div id="wishItems"></div>
  <div class="notice">Tip: add a direct shopping link whenever possible.</div>
  <label>Gift idea</label><input id="giftName" placeholder="e.g. LEGO set">
  <label>Link (optional)</label><input id="giftLink" placeholder="https://...">
  <label>Price (optional)</label><input id="giftPrice" placeholder="$25">
  <label>Size / color / notes</label><textarea id="giftNotes" rows="3" placeholder="Size, color, favorite version, etc."></textarea>
  <button class="btn" style="margin-top:12px" onclick="addWish()">Add to Wishlist</button>
 </div>
</section>

<section id="admin" class="hidden">
 <div class="card">
  <h2>🎄 Family Coordinator</h2>
  <p class="muted">This dashboard is designed for the family coordinator. The draw is generated locally and prevents people from drawing someone in their own household.</p>
  <div class="notice"><b>Coordinator access:</b> Hughes household is set up as the coordinator household.</div>
  <button class="btn gold" onclick="drawSanta()">🎲 Generate / Regenerate Secret Santa</button>
  <button class="btn" onclick="exportData()" style="margin-left:8px">💾 Export Backup</button>
  <div id="adminResults" style="margin-top:20px"></div>
 </div>
</section>
</main>
<footer>Made for Christmas magic 🎄 • Family Secret Santa</footer>

<script>
const people = [
 ["Valerie","Hughes"],["Chuck","Hughes"],["Erik","Hughes"],["Jack","Hughes"],
 ["Brianna","Valdez/Smith"],["Rodolfo","Valdez/Smith"],
 ["Sabra","Gamberella"],["Cody","Gamberella"],["Michael","Gamberella"],["Garrett","Gamberella"],
 ["Amber","Smith/Musial"],["Mike","Smith/Musial"],
 ["Destiny","Des/Joe"],["Joe","Des/Joe"],
 ["Debbie","Haveard"],["Ron","Haveard"],
 ["Jason","Park"],["Marissa","Park"],["Carmen","Park"],["Connor","Park"]
];
const key = p => p[0]+"|"+p[1];
let current = localStorage.getItem("ss_current") || "";
let wishes = JSON.parse(localStorage.getItem("ss_wishes") || "{}");
let assignments = JSON.parse(localStorage.getItem("ss_assignments") || "{}");

function show(id){
 document.querySelectorAll("main>section").forEach(s=>s.classList.add("hidden"));
 document.getElementById(id).classList.remove("hidden");
 if(id==="login") fillPeople();
 if(id==="wishlist") renderWishlist();
 if(id==="dashboard") renderDashboard();
 if(id==="admin") renderAdmin();
}
function fillPeople(){
 const s=document.getElementById("personSelect");
 s.innerHTML=people.map(p=>`<option value="${key(p)}">${p[0]} ${p[1]}</option>`).join("");
 if(current) s.value=current;
}
function login(){
 current=document.getElementById("personSelect").value; localStorage.setItem("ss_current",current);
 show("dashboard");
}
function pFromKey(k){return people.find(p=>key(p)===k)}
function renderDashboard(){
 if(!current){show("login");return}
 const p=pFromKey(current), rec=assignments[current], rp=rec?pFromKey(rec):null;
 document.getElementById("dash").innerHTML=`
 <div class="card">
   <span class="tag">${p[1]}</span><h2>Welcome, ${p[0]}! 🎄</h2>
   <p class="muted">This is your private Secret Santa page.</p>
   <div class="reveal">
    <div>🎁 Your Secret Santa recipient is...</div>
    ${rp?`<div class="name">${rp[0]}</div><div>${rp[1]}</div>`:`<div class="name">Not drawn yet</div><p class="muted">Ask the coordinator to generate the Secret Santa draw.</p>`}
   </div>
   ${rp?`<div style="margin-top:18px"><h3>🎁 Their Wishlist</h3>${renderWishHTML(rec)}</div>`:""}
   <button class="btn" onclick="show('wishlist')" style="margin-top:12px">📝 Edit My Wishlist</button>
 </div>`;
}
function renderWishHTML(personKey){
 const arr=wishes[personKey]||[];
 if(!arr.length) return `<p class="muted">No wishlist items yet.</p>`;
 return arr.map((w,i)=>`<div class="wish"><strong>${esc(w.name)}</strong>
 ${w.price?`<span class="price">${esc(w.price)}</span>`:""} 
 ${w.link?`<br><a href="${safeUrl(w.link)}" target="_blank" rel="noopener">View gift idea ↗</a>`:""}
 ${w.notes?`<p class="muted">${esc(w.notes)}</p>`:""}</div>`).join("");
}
function renderWishlist(){
 if(!current){document.getElementById("wishFor").textContent="Choose your name from My Santa first.";document.getElementById("wishItems").innerHTML="";return}
 const p=pFromKey(current);document.getElementById("wishFor").textContent=`Wishlist for ${p[0]} ${p[1]}`;
 document.getElementById("wishItems").innerHTML=renderWishHTML(current);
}
function addWish(){
 if(!current){alert("Choose your name first.");show("login");return}
 const name=document.getElementById("giftName").value.trim();if(!name){alert("Add a gift idea first.");return}
 wishes[current]=wishes[current]||[];
 wishes[current].push({name,link:document.getElementById("giftLink").value.trim(),price:document.getElementById("giftPrice").value.trim(),notes:document.getElementById("giftNotes").value.trim()});
 localStorage.setItem("ss_wishes",JSON.stringify(wishes));
 ["giftName","giftLink","giftPrice","giftNotes"].forEach(id=>document.getElementById(id).value="");
 renderWishlist();
}
function drawSanta(){
 const n=people.length; let best=null;
 for(let attempt=0;attempt<10000;attempt++){
  let targets=[...people].sort(()=>Math.random()-.5), ok=true, seen=new Set();
  for(let i=0;i<n;i++){
   if(key(targets[i])===key(people[i]) || targets[i][1]===people[i][1]){ok=false;break}
   if(seen.has(key(targets[i]))){ok=false;break} seen.add(key(targets[i]));
  }
  if(ok){best={};for(let i=0;i<n;i++)best[key(people[i])]=key(targets[i]);break}
 }
 if(!best){alert("Could not create a valid draw. Try again.");return}
 assignments=best;localStorage.setItem("ss_assignments",JSON.stringify(assignments));renderAdmin();alert("🎁 Secret Santa draw created!");
}
function renderAdmin(){
 const el=document.getElementById("adminResults");
 if(!Object.keys(assignments).length){el.innerHTML="<p class='muted'>No draw has been generated yet.</p>";return}
 el.innerHTML=`<h3>Coordinator View</h3>`+people.map(p=>{
  const r=pFromKey(assignments[key(p)]);return `<div class="person"><span><b>${p[0]}</b> <span class="muted">${p[1]}</span></span><span>→ <b>${r[0]}</b> <span class="muted">${r[1]}</span></span></div>`;
 }).join("");
}
function exportData(){
 const blob=new Blob([JSON.stringify({people,assignments,wishes},null,2)],{type:"application/json"});
 const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="family-secret-santa-backup.json";a.click();URL.revokeObjectURL(a.href);
}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function safeUrl(u){try{const x=new URL(u);return ["http:","https:"].includes(x.protocol)?x.href:"#"}catch{return "#"}}
fillPeople();
</script>
</body>
</html>
